{
  "name": "dossier-folders-kit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src demo tests scripts",
    "build": "npm run typecheck && vite build && npm run build:library",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "pack:library": "npm run build:library && node scripts/pack-library.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "generate:assets": "node scripts/generate-assets.mjs",
    "verify:product": "node scripts/verify-product.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "check": "npm run lint && npm run build && npm test && npm run verify:product",
    "verify:hosted": "node scripts/check-hosted.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "fflate": "^0.8.2",
    "oxlint": "^1.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
